# Honest Bot Pro API Credentials
# Configure these securely in the AI Studio Secrets panel.
# Never commit a real .env file to version control.

# OpenAI API Key for Responses API + live web_search intelligence
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Meta WhatsApp Business Cloud API credentials (graph.facebook.com/v26.0)
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID

# Optional: Cobalt-compatible Media Extractor REST base URL for .play/.video stream extraction
MEDIA_EXTRACTOR_URL=YOUR_MEDIA_EXTRACTOR_URL
